# Copy this file to .env and fill in your values. Never commit the .env file.
# DevResolve works with any provider that offers an OpenAI-compatible chat API.
LLM_API_KEY=paste-your-key-here
LLM_MODEL=paste-a-model-name-from-your-provider-here
# Leave LLM_BASE_URL empty for OpenAI. For other providers use the URL from their documentation, for example:
#   Groq:          https://api.groq.com/openai/v1
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
#   Local Ollama:  http://localhost:11434/v1   (then set LLM_API_KEY=ollama)
# Check your provider's documentation for the exact URL and the current model names.
LLM_BASE_URL=
# Seconds to wait between calls in batch runs (helps with free-plan rate limits)
LLM_DELAY_SECONDS=2
